# Modelo das variáveis de produção. COPIE para docker/.env e preencha com valores reais.
# NÃO comite o docker/.env (já está no .gitignore). Ver docs/deploy.md.

# --- Banco (Postgres) ---
POSTGRES_USER=retaguarda
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=RetaguardaBase

# --- API (JWT) ---
# Chave de assinatura do JWT da API (>= 32 bytes). Gere uma forte, ex.:
#   openssl rand -base64 48
JWT_SIGNING_KEY=troque-por-uma-chave-base64-forte

# --- Hosts permitidos (por app) ---
WEB_ALLOWED_HOSTS=exemplo.com.br
API_ALLOWED_HOSTS=api.exemplo.com.br

# --- Admin inicial (criado no 1º boot; idempotente) ---
# Troque a senha após o primeiro login. Politica: 8+ chars, maiuscula, minuscula, digito e simbolo.
SEED_ADMIN_EMAIL=admin@exemplo.com.br
SEED_ADMIN_PASSWORD=troque-por-uma-senha-forte
