<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Retaguarda.Data\Retaguarda.Data.csproj" />
    <ProjectReference Include="..\Retaguarda.Business\Retaguarda.Business.csproj" />
    <ProjectReference Include="..\Retaguarda.Shared\Retaguarda.Shared.csproj" />
    <ProjectReference Include="..\Retaguarda.AspNetCore\Retaguarda.AspNetCore.csproj" />
    <ProjectReference Include="..\Retaguarda.Printing\Retaguarda.Printing.csproj" />
    <ProjectReference Include="..\Retaguarda.Reporting\Retaguarda.Reporting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <!-- Override transitivo: a 9.0.0 (puxada por EntityFrameworkCore.Design via Microsoft.Build.Tasks.Core)
         tem 2 CVEs high. PrivateAssets=all porque é só design-time/build.
         NoWarn NU1510: em runtime o Microsoft.AspNetCore.App shared framework já fornece este assembly,
         mas precisamos da referência direta para forçar a versão patched em design-time. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" NoWarn="NU1510">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>60bd8323-fbc3-40d5-a8f3-733efadbb119</UserSecretsId>
  </PropertyGroup>

</Project>
