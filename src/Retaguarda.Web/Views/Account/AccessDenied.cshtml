@inject IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["access_denied_title"].Value;
}

<div class="page-header">
    <h1>@L["access_denied_title"]</h1>
</div>

<p class="text-muted">@L["access_denied_message"]</p>
<a asp-controller="Home" asp-action="Index" class="btn btn-primary">@L["back_to_home"]</a>
