@model Retaguarda.Web.Models.Account.ForgotPasswordViewModel
@inject IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["forgot_password_title"].Value;
    Layout = "_LayoutAuth";
}

<h1 class="h5 mb-3 text-center">@L["forgot_password_title"]</h1>
<p class="text-muted small">@L["forgot_password_intro"]</p>

<form asp-controller="Account" asp-action="ForgotPassword" method="post" data-disable-on-submit>
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    }

    <div class="mb-3">
        <label asp-for="Email" class="form-label">@L["login_email_label"]</label>
        <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100" data-loading-text="@L["forgot_password_submitting"]">
        @L["forgot_password_submit"]
    </button>
</form>

<div class="text-center mt-3">
    <a asp-controller="Account" asp-action="Login" class="small">@L["back_to_login"]</a>
</div>
