@inject IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["forgot_password_confirmation_title"].Value;
    Layout = "_LayoutAuth";
}

<h1 class="h5 mb-3 text-center">@L["forgot_password_confirmation_title"]</h1>
<p class="text-muted">@L["forgot_password_confirmation_message"]</p>

<div class="text-center mt-3">
    <a asp-controller="Account" asp-action="Login" class="small">@L["back_to_login"]</a>
</div>
