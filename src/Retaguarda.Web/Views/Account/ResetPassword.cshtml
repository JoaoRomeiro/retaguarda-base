@model Retaguarda.Web.Models.Account.ResetPasswordViewModel
@inject IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["reset_password_title"].Value;
    Layout = "_LayoutAuth";
}

<h1 class="h5 mb-4 text-center">@L["reset_password_title"]</h1>

<form asp-controller="Account" asp-action="ResetPassword" method="post" data-disable-on-submit>
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Code" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    }

    <div class="mb-3">
        <label asp-for="Password" class="form-label">@L["reset_password_new_label"]</label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" autofocus />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label">@L["reset_password_confirm_label"]</label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100" data-loading-text="@L["reset_password_submitting"]">
        @L["reset_password_submit"]
    </button>
</form>

<div class="text-center mt-3">
    <a asp-controller="Account" asp-action="Login" class="small">@L["back_to_login"]</a>
</div>
