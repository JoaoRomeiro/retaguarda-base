@inject IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["reset_password_confirmation_title"].Value;
    Layout = "_LayoutAuth";
}

<h1 class="h5 mb-3 text-center">@L["reset_password_confirmation_title"]</h1>
<p class="text-muted">@L["reset_password_confirmation_message"]</p>

<a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100">@L["nav_login"]</a>
