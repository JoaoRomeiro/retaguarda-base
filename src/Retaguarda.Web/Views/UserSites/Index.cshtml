@model Retaguarda.Web.Models.Users.UserSiteIndexViewModel
@inject IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = string.Format(L["usersites_title"].Value, Model.UserName);
    var sites = Model.Sites;
    var userSearch = ViewData["UserSearch"] as string;
    var userPage = ViewData["UserPage"];

    // Cada botão aparece pela permissão da ação que ele dispara.
    var canCreate = User.HasPermission(PlatformPermissions.UserSites.Create);
    var canDelete = User.HasPermission(PlatformPermissions.UserSites.Delete);
}

<div class="page-header">
    <h1>@string.Format(L["usersites_title"].Value, Model.UserName)</h1>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success" role="alert">@status</div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="card card-accent mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-end gap-2 mb-3">
            @* Voltar: volta ao index de Usuários preservando busca+página filtradas. *@
            <a asp-controller="Users" asp-action="Index" asp-route-search="@userSearch" asp-route-page="@userPage"
               class="btn btn-sm btn-primary">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> @L["back"]
            </a>
            @if (canCreate)
            {
                <a asp-action="Create" asp-route-userId="@Model.UserId" asp-route-userSearch="@userSearch"
                   asp-route-userPage="@userPage" asp-route-search="@Model.Search" asp-route-page="@sites.Page"
                   class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> @L["new"]
                </a>
            }
        </div>

        <form asp-action="Index" method="get" class="mb-3" role="search">
            <input type="hidden" name="userId" value="@Model.UserId" />
            <input type="hidden" name="userSearch" value="@userSearch" />
            <input type="hidden" name="userPage" value="@userPage" />
            <div class="input-group">
                <input type="search" name="search" value="@Model.Search" class="form-control"
                       placeholder="@L["usersites_search_placeholder"]" aria-label="@L["search"]" />
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search" aria-hidden="true"></i>
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <a asp-action="Index" asp-route-userId="@Model.UserId" asp-route-userSearch="@userSearch"
                       asp-route-userPage="@userPage" class="btn btn-secondary">
                        <i class="bi bi-x-lg" aria-hidden="true"></i> @L["clear_search"]
                    </a>
                }
            </div>
        </form>

        @if (sites.Items.Count == 0)
        {
            <p class="text-muted mb-0">@L["usersites_empty"]</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@L["site_field_code"]</th>
                            <th>@L["site_field_name"]</th>
                            @if (canDelete)
                            {
                                <th class="text-end">@L["actions"]</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var site in sites.Items)
                        {
                            <tr>
                                <td>@site.Code</td>
                                <td>
                                    @site.Name
                                    @if (site.IsDefault)
                                    {
                                        <span class="badge text-bg-secondary ms-1">@L["usersite_badge_default"]</span>
                                    }
                                </td>
                                @if (canDelete)
                                {
                                    <td class="text-end">
                                        @* A planta padrão não pode ser removida: o botão nem aparece. *@
                                        @if (!site.IsDefault)
                                        {
                                            <a asp-action="Delete" asp-route-userId="@Model.UserId" asp-route-siteId="@site.SiteId"
                                               asp-route-userSearch="@userSearch" asp-route-userPage="@userPage"
                                               asp-route-search="@Model.Search" asp-route-page="@sites.Page"
                                               class="btn btn-sm btn-danger">@L["usersite_remove"]</a>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (sites.TotalPages > 1)
    {
        <div class="card-footer">
            <nav class="d-flex justify-content-between align-items-center" aria-label="@L["pagination_label"]">
                <span class="text-muted small">@string.Format(L["pagination_info"].Value, sites.Page,
                                                        sites.TotalPages)</span>
                    <div class="btn-group">
                        <a class="btn btn-outline-secondary btn-sm @(sites.Page <= 1 ? "disabled" : null)" asp-action="Index"
                           asp-route-userId="@Model.UserId" asp-route-userSearch="@userSearch" asp-route-userPage="@userPage"
                           asp-route-search="@Model.Search" asp-route-page="@(sites.Page - 1)">@L["pagination_prev"]</a>
                        <a class="btn btn-outline-secondary btn-sm @(sites.Page >= sites.TotalPages ? "disabled" : null)"
                           asp-action="Index" asp-route-userId="@Model.UserId" asp-route-userSearch="@userSearch"
                           asp-route-userPage="@userPage" asp-route-search="@Model.Search"
                           asp-route-page="@(sites.Page + 1)">@L["pagination_next"]</a>
                    </div>
                </nav>
            </div>
        }
    </div>
