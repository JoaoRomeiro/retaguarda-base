@model Retaguarda.Web.Models.Roles.RoleIndexViewModel
@inject IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["roles_title"].Value;
    var roles = Model.Roles;
}

<div class="page-header">
    <h1>@L["roles_title"]</h1>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success" role="alert">@status</div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="card card-accent mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-end gap-2 mb-3">
            @* Voltar: por ora aponta para a home; cada tela definirá seu próprio destino. *@
            <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-primary">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> @L["back"]
            </a>
            <a asp-action="Create" asp-route-search="@Model.Search" asp-route-page="@roles.Page"
               class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> @L["new"]
            </a>
        </div>

        <form asp-action="Index" method="get" class="mb-3" role="search">
            <div class="input-group">
                <input type="search" name="search" value="@Model.Search" class="form-control"
                       placeholder="@L["roles_search_placeholder"]" aria-label="@L["search"]" />
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search" aria-hidden="true"></i>
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-lg" aria-hidden="true"></i> @L["clear_search"]
                    </a>
                }
            </div>
        </form>

        @if (roles.Items.Count == 0)
        {
            <p class="text-muted mb-0">@L["roles_empty"]</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@L["role_field_name"]</th>
                            <th>@L["role_field_description"]</th>
                            <th>@L["role_field_type"]</th>
                            <th class="text-end">@L["actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in roles.Items)
                        {
                            <tr>
                                <td>@role.Name</td>
                                <td class="cell-truncate" title="@role.Description">@role.Description</td>
                                <td>
                                    @if (role.IsSystem)
                                    {
                                        <span class="badge text-bg-secondary">@L["role_type_system"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-info">@L["role_type_custom"]</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@role.Id" asp-route-search="@Model.Search"
                                       asp-route-page="@roles.Page" class="btn btn-sm btn-primary">@L["edit"]</a>
                                    @* Papéis internos não podem ser excluídos: o botão nem aparece. *@
                                    @if (!role.IsSystem)
                                    {
                                        <a asp-action="Delete" asp-route-id="@role.Id" asp-route-search="@Model.Search"
                                           asp-route-page="@roles.Page" class="btn btn-sm btn-danger">@L["delete"]</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @* Paginação no rodapé do card. Extrair para ViewComponent ao chegar na 2ª tela (§15.4 / item 2.10). *@
    @if (roles.TotalPages > 1)
    {
        <div class="card-footer">
            <nav class="d-flex justify-content-between align-items-center" aria-label="@L["pagination_label"]">
                <span class="text-muted small">@string.Format(L["pagination_info"].Value, roles.Page, roles.TotalPages)</span>
                <div class="btn-group">
                    <a class="btn btn-outline-secondary btn-sm @(roles.Page <= 1 ? "disabled" : null)" asp-action="Index"
                       asp-route-search="@Model.Search" asp-route-page="@(roles.Page - 1)">@L["pagination_prev"]</a>
                    <a class="btn btn-outline-secondary btn-sm @(roles.Page >= roles.TotalPages ? "disabled" : null)"
                       asp-action="Index" asp-route-search="@Model.Search"
                       asp-route-page="@(roles.Page + 1)">@L["pagination_next"]</a>
                </div>
            </nav>
        </div>
    }
</div>
