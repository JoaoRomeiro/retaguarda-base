@model Retaguarda.Web.Models.Users.UserIndexViewModel
@inject IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["users_title"].Value;
    var users = Model.Users;
    var currentUserId = ViewData["CurrentUserId"] as string;
}

<div class="page-header">
    <h1>@L["users_title"]</h1>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success" role="alert">@status</div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="card card-accent mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-end gap-2 mb-3">
            @* Voltar: por ora aponta para a home; cada tela definirá seu próprio destino. *@
            <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-primary">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> @L["back"]
            </a>
            <a asp-action="Create" asp-route-search="@Model.Search" asp-route-page="@users.Page"
               class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> @L["new"]
            </a>
        </div>

        <form asp-action="Index" method="get" class="mb-3" role="search">
            <div class="input-group">
                <input type="search" name="search" value="@Model.Search" class="form-control"
                       placeholder="@L["users_search_placeholder"]" aria-label="@L["search"]" />
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search" aria-hidden="true"></i>
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-lg" aria-hidden="true"></i> @L["clear_search"]
                    </a>
                }
            </div>
        </form>

        @if (users.Items.Count == 0)
        {
            <p class="text-muted mb-0">@L["users_empty"]</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@L["user_field_fullname"]</th>
                            <th>@L["user_field_email"]</th>
                            <th>@L["user_field_role"]</th>
                            <th>@L["user_field_default_site"]</th>
                            <th>@L["user_field_active"]</th>
                            <th class="text-end">@L["actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in users.Items)
                        {
                            <tr>
                                <td class="cell-truncate" title="@user.FullName">@user.FullName</td>
                                <td>@user.Email</td>
                                <td>@user.RoleName</td>
                                <td>@user.DefaultSiteName</td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge text-bg-success">@L["active_yes"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">@L["active_no"]</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-controller="UserSites" asp-action="Index" asp-route-userId="@user.Id"
                                       asp-route-userSearch="@Model.Search" asp-route-userPage="@users.Page"
                                       class="btn btn-sm btn-secondary">@L["user_field_sites"]</a>
                                    <a asp-action="Edit" asp-route-id="@user.Id" asp-route-search="@Model.Search"
                                       asp-route-page="@users.Page" class="btn btn-sm btn-primary">@L["edit"]</a>
                                    @* Não permite excluir a própria conta: o botão nem aparece. *@
                                    @if (!string.Equals(user.Id, currentUserId, StringComparison.Ordinal))
                                    {
                                        <a asp-action="Delete" asp-route-id="@user.Id" asp-route-search="@Model.Search"
                                           asp-route-page="@users.Page" class="btn btn-sm btn-danger">@L["delete"]</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @* Paginação no rodapé do card. Extrair para ViewComponent ao chegar na 2ª tela (§15.4 / item 2.10). *@
    @if (users.TotalPages > 1)
    {
        <div class="card-footer">
            <nav class="d-flex justify-content-between align-items-center" aria-label="@L["pagination_label"]">
                <span class="text-muted small">@string.Format(L["pagination_info"].Value, users.Page, users.TotalPages)</span>
                <div class="btn-group">
                    <a class="btn btn-outline-secondary btn-sm @(users.Page <= 1 ? "disabled" : null)" asp-action="Index"
                       asp-route-search="@Model.Search" asp-route-page="@(users.Page - 1)">@L["pagination_prev"]</a>
                    <a class="btn btn-outline-secondary btn-sm @(users.Page >= users.TotalPages ? "disabled" : null)"
                       asp-action="Index" asp-route-search="@Model.Search"
                       asp-route-page="@(users.Page + 1)">@L["pagination_next"]</a>
                </div>
            </nav>
        </div>
    }
</div>
