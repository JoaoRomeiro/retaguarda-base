@inject IStringLocalizer<SharedResources> L
@{
    // Marca o item de navegação correspondente à rota atual.
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string? Active(string c, string a) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, a, StringComparison.OrdinalIgnoreCase) ? "active" : null;
}
<aside class="app-sidebar" id="appSidebar" aria-label="@L["nav_primary_aria"]">
    <div class="app-sidebar-brand">
        <a class="app-brand" asp-controller="Home" asp-action="Index">
            <partial name="_BrandIcon" />
            <span>@L["app_title"]</span>
        </a>
        @* Fecha a sidebar no mobile; controlado por site.js (sem offcanvas do Bootstrap). *@
        <button type="button" class="btn-close btn-close-white d-md-none" id="sidebarClose"
                aria-label="@L["close"]"></button>
    </div>

    <nav class="app-sidebar-nav" aria-label="@L["nav_primary_aria"]">
        <div class="sidebar-section">@L["nav_section_general"]</div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link @Active("Home", "Index")" asp-controller="Home" asp-action="Index"
                   title="@L["nav_home"]">
                    <i class="bi bi-house-door" aria-hidden="true"></i>
                    <span>@L["nav_home"]</span>
                </a>
            </li>
        </ul>

        @* Cadastros — visível só para Admin (configuração do tenant). *@
        @if (User.IsInRole("Admin"))
        {
            var sitesActive = string.Equals(controller, "Sites", StringComparison.OrdinalIgnoreCase) ? "active" : null;
            var rolesActive = string.Equals(controller, "Roles", StringComparison.OrdinalIgnoreCase) ? "active" : null;
            var usersActive = string.Equals(controller, "Users", StringComparison.OrdinalIgnoreCase) ? "active" : null;
            <div class="sidebar-section">@L["nav_section_registrations"]</div>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @rolesActive" asp-controller="Roles" asp-action="Index" title="@L["nav_roles"]">
                        <i class="bi bi-person-badge" aria-hidden="true"></i>
                        <span>@L["nav_roles"]</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @usersActive" asp-controller="Users" asp-action="Index" title="@L["nav_users"]">
                        <i class="bi bi-people" aria-hidden="true"></i>
                        <span>@L["nav_users"]</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @sitesActive" asp-controller="Sites" asp-action="Index" title="@L["nav_sites"]">
                        <i class="bi bi-buildings" aria-hidden="true"></i>
                        <span>@L["nav_sites"]</span>
                    </a>
                </li>
            </ul>
        }

    </nav>
</aside>
